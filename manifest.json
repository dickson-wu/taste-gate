{
  "manifest_version": 3,
  "name": "Taste Gate for Pinterest",
  "version": "1.0.0",
  "description": "Turns your taste into clear rules and checks every Pinterest pin as you scroll: green fits, orange is unsure, red breaks a rule. Powered by Jev (TypeSafe), with your own key.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://api.typesafe.ai/*", "https://i.pinimg.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.pinterest.com/*"],
      "js": ["lens.js", "pinterest.js"],
      "css": ["pinterest.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Taste Gate" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
